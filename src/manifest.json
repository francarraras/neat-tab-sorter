{
    "name": "Neat Tab Sorter",
    "description": "Sort tabs by title, URL, site or recent use in one click. Tab groups stay intact, numbers sort naturally, and you can undo.",
    "version": "1.0.0",
    "manifest_version": 3,
    "minimum_chrome_version": "102",
    "homepage_url": "https://github.com/francarraras/neat-tab-sorter",
    "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_title": "Sort tabs (right-click for undo and sort options)",
        "default_icon": {
            "16": "img/16.png",
            "32": "img/32.png",
            "48": "img/48.png",
            "128": "img/128.png"
        }
    },
    "icons": {
        "16": "img/16.png",
        "32": "img/32.png",
        "48": "img/48.png",
        "128": "img/128.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+Shift+S" },
            "description": "Sort tabs in the current window"
        },
        "undo-sort": {
            "description": "Undo the last sort in the current window"
        }
    },
    "options_page": "options.html"
}
