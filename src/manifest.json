{
    "name": "Simple Tab Sorter",
    "description": "Simple tab sorter that allows user-defined tab group order.",
    "version": "0.5.0",
    "manifest_version": 3,
    "minimum_chrome_version": "102",
    "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_title": "Sort tabs (right-click for undo and sort options)",
        "default_icon": {
            "16": "img/16.png",
            "48": "img/48.png",
            "128": "img/128.png"
        }
    },
    "icons": {
        "16": "img/16.png",
        "48": "img/48.png",
        "128": "img/128.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+Shift+S" },
            "description": "Sort tabs in the current window"
        },
        "undo-sort": {
            "description": "Undo the last sort in the current window"
        }
    },
    "options_page": "options.html"
}
